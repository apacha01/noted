---
import TrainerApp from "../components/TrainerApp";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Learn to recognize music notes on the piano and staff." />
    <meta name="theme-color" content="#f4eddf" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>♪</text></svg>" />
    <title>Noted — Music note trainer</title>
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('noted:theme') || 'system';
        const dark = saved === 'dark' || (saved === 'system' && matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
      })();
    </script>
  </head>
  <body>
    <TrainerApp client:load />
  </body>
</html>
